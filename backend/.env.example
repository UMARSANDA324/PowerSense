# MongoDB connection
MONGO_URI=mongodb://localhost:27017/powersense

# JWT
JWT_SECRET=replace_with_long_secret
JWT_REFRESH_SECRET=replace_with_long_refresh_secret

# Frontend allowed origins (comma separated)
FRONTEND_URL=http://localhost:5173

# Gemini API (set to your provider's URL if different)
GEMINI_API_KEY=
GEMINI_API_URL=https://api.your-gemini-provider.com/v1/generate
GEMINI_MODEL=gemini-pro-mini

# Enable periodic prediction generation (true/false)
ENABLE_PREDICTIONS=true

# Environment
NODE_ENV=development
PORT=5000
# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/powersense?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your_jwt_secret_key

# Email Configuration (Nodemailer)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Firebase Admin Configuration (For Push Notifications)
# You can find these in Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourKeyHere\n-----END PRIVATE KEY-----\n"

# Frontend URL for CORS (Production)
FRONTEND_URL=https://your-frontend-url.onrender.com
